# SOCCA Sales Cockpit — Zugang zu SharePoint
#
# Kopieren nach  /opt/socca-tools/socca-cockpit/sharepoint.env  und ausfüllen:
#   cp deploy/sharepoint.env.vorlage sharepoint.env && chmod 600 sharepoint.env
# Diese Datei enthält ein Passwort (Client-Secret). Sie gehört nicht ins
# Repository — die .gitignore schließt sie aus.

# Aus der App-Registrierung in Entra (Übersicht der App)
SP_TENANT_ID=
SP_CLIENT_ID=
# Unter „Zertifikate & Geheimnisse“ — der WERT, nicht die Secret-ID.
SP_CLIENT_SECRET=
# Ablaufdatum des Secrets, nur als Erinnerung für dich:
# SP_SECRET_EXPIRES=

# Die SharePoint-Site
SP_SITE=socca.sharepoint.com:/sites/SOCCASales

# Dokumentbibliothek. Leer = Standardbibliothek („Freigegebene Dokumente“).
SP_LIBRARY=

# Pfad der Dateien innerhalb der Bibliothek. Beide liegen dort direkt im
# Hauptordner. Liegt eine Datei in einem Unterordner: Ordner/Datei.xlsx
# Achtung: Unter Sales_19082025/ liegt eine ältere Sales.xlsb — nicht die.
SP_SALES=Sales.xlsb
SP_CAP=C_AP.xlsx

# Optional: Lead-Planung, Aufbau siehe deploy/AP_Leads.vorlage.csv
SP_APLEADS=
