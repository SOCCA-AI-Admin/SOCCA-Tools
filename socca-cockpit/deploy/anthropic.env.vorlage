# SOCCA Sales Cockpit — Zugang zur Claude API für „Frag das Cockpit“
#
# Kopieren nach  /opt/socca-tools/socca-cockpit/anthropic.env  und ausfüllen:
#   cp deploy/anthropic.env.vorlage anthropic.env && chmod 600 anthropic.env
# Enthält den API-Schlüssel. Gehört nicht ins Repository — die .gitignore
# schließt die Datei aus. Änderungen wirken sofort, ohne Neustart.

# API-Schlüssel aus der Claude Console (Workspace „SOCCA Cockpit“), beginnt mit sk-ant-
ANTHROPIC_API_KEY=

# Modell. Standard: claude-sonnet-5-5
# Günstiger, etwas weniger gründlich: claude-haiku-4-5-20251001
ASK_MODEL=claude-sonnet-5-5

# Höchstzahl Fragen pro Tag für alle zusammen
ASK_DAILY_LIMIT=200

# Länge der Antwort in Tokens (1500 ≈ eine halbe Seite)
ASK_MAX_TOKENS=1500

# Fragen im Protokoll .state/ask.log mitschreiben (ja/nein).
# Hilft zu sehen, was gefragt wird; enthält keine Namen oder IP-Adressen.
ASK_LOG_QUESTIONS=ja
